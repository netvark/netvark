{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Resolve `@netvark/resource-core`, and the packages it builds on, to
    // their source through the `source` condition of their exports maps
    // (written by tsdown's `devExports`), so the bindings type-check against
    // the declarations as they are edited, without a build in between.
    // Consumers, e2e/resource/ included, never see the condition.
    // @ref https://tsdown.dev/options/package-exports#devexports
    // @ref https://www.typescriptlang.org/tsconfig/#customConditions
    "customConditions": ["source"],
    // The screen tests render with React's automatic runtime.
    // @ref https://www.typescriptlang.org/tsconfig/#jsx
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.config.ts"],
  "exclude": ["dist", "node_modules", "coverage"]
}
