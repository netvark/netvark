{
  "name": "@netvark/react-resource",
  "version": "0.0.0",
  "description": "React forms, lists, and query caches from @netvark/resource-core declarations: labels and options from the application's messages, validation in the server's words, the write a form sends, refusals on their fields, and list state as TanStack Table v9 holds it, bound to TanStack Form and TanStack Query.",
  "keywords": [
    "forms",
    "json-api",
    "jsonapi",
    "react",
    "tanstack-form",
    "tanstack-query",
    "tanstack-table"
  ],
  "homepage": "https://github.com/netvark/netvark/tree/main/packages/react-resource#readme",
  "bugs": "https://github.com/netvark/netvark/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netvark/netvark.git",
    "directory": "packages/react-resource"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@netvark/resource-core": "workspace:^"
  },
  "peerDependencies": {
    "@netvark/resource-core": "^0.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
