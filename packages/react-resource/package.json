{
  "name": "@netvark/react-resource",
  "version": "0.0.0",
  "description": "React forms, lists, and query caches from @netvark/resource-core declarations: labels and options from the application's messages, validation in the server's words, the write a form sends, refusals on their fields, and list state as TanStack Table v9 holds it, bound to TanStack Form and TanStack Query.",
  "keywords": [
    "forms",
    "json-api",
    "jsonapi",
    "react",
    "tanstack-form",
    "tanstack-query",
    "tanstack-table"
  ],
  "homepage": "https://github.com/netvark/netvark/tree/main/packages/react-resource#readme",
  "bugs": "https://github.com/netvark/netvark/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netvark/netvark.git",
    "directory": "packages/react-resource"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./form": {
      "source": "./src/tanstack-form/index.ts",
      "default": "./dist/form.js"
    },
    "./query": {
      "source": "./src/tanstack-query/index.ts",
      "default": "./dist/query.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./form": "./dist/form.js",
      "./query": "./dist/query.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netvark/jsonapi-core": "workspace:^"
  },
  "devDependencies": {
    "@netvark/jsonapi-client": "workspace:^",
    "@netvark/resource-core": "workspace:^",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-table": "9.2.8",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@netvark/jsonapi-client": "^0.1.0",
    "@netvark/resource-core": "^0.1.0",
    "@tanstack/react-form": "^1.17.0",
    "@tanstack/react-query": "^5.89.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-form": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
