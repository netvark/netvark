{
  "name": "@netvark/jsonapi-client",
  "version": "0.0.0",
  "description": "A typed fetch client for JSON:API 1.1 servers: calls, queries, records, and errors typed from the @netvark/jsonapi-core definitions the server is built from, with nothing generated. Runs wherever fetch does.",
  "keywords": [
    "client",
    "cursor-pagination",
    "fetch",
    "json-api",
    "jsonapi",
    "rest",
    "typed"
  ],
  "homepage": "https://github.com/netvark/netvark/tree/main/packages/jsonapi-client#readme",
  "bugs": "https://github.com/netvark/netvark/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netvark/netvark.git",
    "directory": "packages/jsonapi-client"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netvark/jsonapi-core": "workspace:^"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
