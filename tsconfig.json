{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The root config files and the repository's scripts. Packages and e2e/
  // have their own tsconfig.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The scripts run under Node's type stripping, which needs each relative
    // import to name its `.ts` file.
    // @ref https://nodejs.org/api/typescript.html#determining-module-system ("file extensions are mandatory")
    "allowImportingTsExtensions": true
  },
  "include": ["*.config.ts", "scripts/**/*.ts"]
}
