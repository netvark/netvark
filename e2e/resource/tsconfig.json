{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The e2e package is a consumer: it type-checks against the emitted
  // declarations in ../packages/*/dist through the published `exports`
  // maps, exactly as an installed copy would (no `source` condition here).
  // Build first (`pnpm build` at the root). `fails/` holds declarations that
  // must not compile; `fails.e2e.test.ts` compiles them on their own.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The smoke entry points import siblings as `./x.ts` so Bun, Deno, and
    // Node's type stripping can run them without a bundler.
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", ".tmp", "fails"]
}
