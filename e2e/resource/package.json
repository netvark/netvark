{
  "name": "@netvark/resource-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests: a consumer of the built @netvark/resource-core, declaring resources over the public catalog @netvark/pg-catalog extracts from a realistic application's migrations.",
  "type": "module",
  "scripts": {
    "build": "paraglide-js compile --project ./localization/project.inlang --outdir ./localization/paraglide --strategy preferredLanguage baseLocale --emit-ts-declarations --silent",
    "smoke:bun": "bun run smoke/run.ts",
    "smoke:deno": "deno run --allow-read --allow-env smoke/run.ts",
    "smoke:workerd": "node --experimental-strip-types smoke/workerd.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "write:catalogs": "node --experimental-strip-types scripts/write-catalogs.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@hono/node-server": "catalog:",
    "@inlang/paraglide-js": "2.26.0",
    "@inlang/plugin-message-format": "4.4.5",
    "@netvark/ban-core": "workspace:*",
    "@netvark/catalog-core": "workspace:*",
    "@netvark/hono-ban": "workspace:*",
    "@netvark/hono-jsonapi": "workspace:*",
    "@netvark/hono-resource": "workspace:*",
    "@netvark/jsonapi-core": "workspace:*",
    "@netvark/keyset-core": "workspace:*",
    "@netvark/kysely-resource": "workspace:*",
    "@netvark/pg-catalog": "workspace:*",
    "@netvark/react-resource": "workspace:*",
    "@netvark/resource-core": "workspace:*",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "hono": "catalog:",
    "kysely": "catalog:",
    "miniflare": "catalog:",
    "pg": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
