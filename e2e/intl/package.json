{
  "name": "@netvark/intl-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests: a consumer of the built @netvark/intl-core package, laid out with a conforming implementation of the Unicode Bidirectional Algorithm and run on Bun, Deno, and workerd.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "smoke:bun": "bun run smoke/run.ts",
    "smoke:deno": "deno run --allow-read smoke/run.ts",
    "smoke:workerd": "node --experimental-strip-types smoke/workerd.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@netvark/intl-core": "workspace:*",
    "@types/node": "catalog:",
    "bidi-js": "1.1.0",
    "miniflare": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
