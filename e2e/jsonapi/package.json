{
  "name": "@netvark/jsonapi-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests: a consumer of the built @netvark/jsonapi-core, @netvark/hono-jsonapi, and @netvark/jsonapi-client packages, exercised over real HTTP.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "smoke:bun": "bun run smoke/run.ts",
    "smoke:deno": "deno run --allow-read --allow-env smoke/run.ts",
    "smoke:workerd": "node --experimental-strip-types smoke/workerd.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@netvark/hono-ban": "workspace:*",
    "@netvark/hono-jsonapi": "workspace:*",
    "@netvark/jsonapi-client": "workspace:*",
    "@netvark/jsonapi-core": "workspace:*",
    "@types/node": "catalog:",
    "hono": "catalog:",
    "miniflare": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
