{
  "name": "@netvark/ban-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests: a consumer of the built @netvark/ban-core and @netvark/hono-ban packages, exercised over real HTTP.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "smoke:bun": "bun run smoke/run.ts",
    "smoke:deno": "deno run --allow-read --allow-env smoke/run.ts",
    "smoke:workerd": "node --experimental-strip-types smoke/workerd.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@hono/node-server": "2.1.3",
    "@hono/standard-validator": "0.4.0",
    "@hono/valibot-validator": "0.6.1",
    "@hono/zod-openapi": "1.6.3",
    "@hono/zod-validator": "0.9.1",
    "@netvark/ban-core": "workspace:*",
    "@netvark/hono-ban": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "miniflare": "4.20260730.0",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
