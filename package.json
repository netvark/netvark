{
  "name": "hono-jsonapi",
  "version": "0.0.0",
  "description": "JSON:API 1.1 for Hono: resources, documents, query parsing, content negotiation, the Cursor Pagination profile, and the Atomic Operations extension.",
  "keywords": [
    "atomic-operations",
    "cursor-pagination",
    "hono",
    "json-api",
    "jsonapi",
    "keyset",
    "middleware",
    "openapi",
    "rest",
    "sparse-fieldsets"
  ],
  "homepage": "https://github.com/ali-issa/hono-jsonapi#readme",
  "bugs": "https://github.com/ali-issa/hono-jsonapi/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-issa/hono-jsonapi.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./atomic": "./dist/atomic.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "check": "pnpm run --sequential \"/^check:/\"",
    "check:deps": "knip",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "check:types": "tsc --noEmit",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm run build",
    "prepare": "lefthook install",
    "release": "pnpm run build && changeset publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build && pnpm --filter hono-jsonapi-e2e run typecheck && pnpm --filter hono-jsonapi-e2e run test",
    "test:runtimes": "pnpm run build && pnpm --filter hono-jsonapi-e2e run smoke:bun && pnpm --filter hono-jsonapi-e2e run smoke:deno && pnpm --filter hono-jsonapi-e2e run smoke:workerd",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hono": "4.13.7",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "hono": ">=4.12.34"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4"
}
